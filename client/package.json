{
  "name": "multimodel-agent-extension",
  "displayName": "Multimodel Agent Extension",
  "description": "An extension for intelligent, multi-model project analysis and chat interactions.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0" 
  },
  "categories": [
    "Programming Languages",
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "analyzer-sidebar",
          "title": "Analyzer",
          "icon": "src/webviews/static/assets/analyzer-logo.png"
        }
      ]
    },
    "views": {
      "analyzer-sidebar": [
        {
          "type": "webview",
          "id": "analyzer.chatView",
          "name": "Chat",
          "icon": "src/webviews/static/assets/analyzer-logo.png",
          "contextualTitle": "Analyzer"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.analyzeProject",
        "title": "Analyzer: Analyze Project Structure"
      },
      {
        "command": "extension.openChat",
        "title": "Analyzer: Open Chat Panel"
      },
      {
        "command": "analyzer.clearChat",
        "title": "Analyzer: Clear Chat History"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --watch --mode development",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./tsconfig.json --outDir out-test",
    "pretest": "npm run test-compile && npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out-test/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0", 
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",                  
    "typescript": "^5.5.3",                 
    "ts-loader": "^9.5.1",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "mocha": "^10.4.0",
    "@vscode/test-electron": "^2.4.0"
  }
}
